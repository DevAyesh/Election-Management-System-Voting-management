# Central Election MongoDB Atlas Cluster (Candidates)
ELECTION_MONGO_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/election?appName=Cluster0"
ELECTION_DB="election"
ELECTION_COLLECTION="candidates"

# Cryptographic Keys (Generate secure random base64 keys for production)
ENCRYPTION_KEY="your-fernet-encryption-key-here="
LEDGER_HMAC_KEY="your-ledger-hmac-sha256-key-here"

# QR Verification MongoDB Atlas Cluster
QR_MONGO_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0"
QR_DB="Election_Management_System"
QR_COLLECTION="qr_codes"

# Django Core Settings
DJANGO_SECRET_KEY="your-django-secret-key-here"
DJANGO_DEBUG="True"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1,web"

# Demo reset mode: MUST stay false on a real election run to preserve votes and ledger
DEMO_RESET=false
